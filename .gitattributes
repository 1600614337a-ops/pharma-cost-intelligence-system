* text=auto
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
# Governed CSV hashes are part of the knowledge-index trust chain. Preserve
# their exact source bytes across Windows and Linux checkouts.
*.csv binary
# Keep CRLF bytes in repository archives so downloaded CMD launchers work
# even when they were not checked out through Git's line-ending conversion.
*.cmd binary
*.bat binary
